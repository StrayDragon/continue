{
  "name": "conti",
  "displayName": "Conti - AI Tab Autocomplete",
  "description": "Lightweight AI-powered tab autocomplete extension",
  "version": "1.0.0",
  "publisher": "Continue",
  "repository": {
    "type": "git",
    "url": "https://github.com/continuedev/continue"
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Machine Learning",
    "Snippets"
  ],
  "keywords": [
    "autocomplete",
    "ai",
    "copilot",
    "claude",
    "tab",
    "completion",
    "fim"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Conti",
      "properties": {
        "conti.enableTabAutocomplete": {
          "type": "boolean",
          "default": true,
          "description": "Enable tab autocomplete feature."
        },
        "conti.enableNextEdit": {
          "type": "boolean",
          "default": true,
          "description": "Enable next edit prediction feature."
        },
        "conti.model": {
          "type": "string",
          "default": "gpt-4",
          "description": "Default model to use for autocomplete."
        },
        "conti.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key for the selected model."
        }
      }
    },
    "commands": [
      {
        "command": "conti.toggleTabAutocompleteEnabled",
        "category": "Conti",
        "title": "Toggle Autocomplete"
      },
      {
        "command": "conti.forceAutocomplete",
        "title": "Conti: Force Autocomplete"
      },
      {
        "command": "conti.toggleNextEditEnabled",
        "title": "Conti: Toggle Next Edit"
      },
      {
        "command": "conti.openConfigPage",
        "category": "Conti",
        "title": "Settings",
        "icon": "$(gear)"
      }
    ],
    "keybindings": [
      {
        "command": "conti.toggleTabAutocompleteEnabled",
        "mac": "cmd+k cmd+a",
        "key": "ctrl+k ctrl+a"
      },
      {
        "command": "conti.forceAutocomplete",
        "key": "ctrl+alt+space",
        "mac": "cmd+alt+space"
      },
      {
        "command": "conti.toggleNextEditEnabled",
        "key": "ctrl+k ctrl+n"
      }
    ]
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "build": "npm run compile && npm run package",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "lint:fix": "eslint src --ext ts --fix",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package --out conti.vsix",
    "clean": "rimraf out"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/follow-redirects": "^1.14.4",
    "@types/node": "16.x",
    "@types/uuid": "^10.0.0",
    "@types/vscode": "1.70",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@vscode/vsce": "^2.22.0",
    "esbuild": "0.17.19",
    "eslint": "^8.28.0",
    "ncp": "^2.0.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@continuedev/config-types": "file:../../packages/config-types",
    "@continuedev/fetch": "file:../../packages/fetch",
    "@vscode/ripgrep": "^1.15.9",
    "axios": "^1.2.5",
    "core": "file:../../core",
    "cors": "^2.8.5",
    "diff": "^7.0.0",
    "express": "^4.18.2",
    "follow-redirects": "^1.15.4",
    "handlebars": "^4.7.8",
    "http-proxy-agent": "^7.0.0",
    "https-proxy-agent": "^7.0.2",
    "ignore": "^5.3.0",
    "lru-cache": "^11.0.2",
    "node-fetch": "^3.3.2",
    "node-machine-id": "^1.1.12",
    "strip-ansi": "^7.1.0",
    "systeminformation": "^5.23.7",
    "uuid": "^9.0.1",
    "vscode-languageclient": "^8.0.2",
    "ws": "^8.13.0"
  }
}